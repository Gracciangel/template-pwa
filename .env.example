# Supabase (proyecto ejwvfmlcjiwxxhduuekh)
# Copiar este archivo a .env y completar con los valores del dashboard:
# Project Settings -> API Keys
VITE_SUPABASE_URL=https://ejwvfmlcjiwxxhduuekh.supabase.co
VITE_ANON_KEY=your_anon_key_here

# Cloudinary (mismos valores que usa la app movil)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Web Push (VAPID) - generar con: npx web-push generate-vapid-keys
# La publica va en el cliente; la privada solo en la Edge Function / backend.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
